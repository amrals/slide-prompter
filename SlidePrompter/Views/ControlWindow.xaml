<Window x:Class="SlidePrompter.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SlidePrompter.Models"
        Title="SlidePrompter — Controles &amp; Editor"
        Width="1100"
        Height="740"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36"
                        Height="36"
                        CornerRadius="9"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1.5"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="13" Height="3.5" CornerRadius="1.5" Background="#F3F4F6" Margin="0,0,3,0"/>
                        <Ellipse Width="5.5" Height="5.5" Fill="#22C55E"/>
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SlidePrompter"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Margin="10,0,0,0"
                                Padding="8,3"
                                CornerRadius="10"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7"
                                         Height="7"
                                         Margin="0,0,6,0"
                                         Fill="{Binding IsPresenting, Converter={StaticResource PresentingToStatusDotBrushConverter}}"/>
                                <TextBlock Text="{Binding PresentationStatusBadge}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Teleprompter discreto de linha única para apresentações e gravações de tela"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding PreviewButtonText}"
                        Command="{Binding TogglePreviewCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Padding="14,9"
                        ToolTip="Exibe a barra no topo sem minimizar os controles para ajustar posição e aparência ao vivo"/>
                <Button Content="{Binding PresentationButtonText}"
                        Command="{Binding TogglePresentationCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="{Binding IsPresenting, Converter={StaticResource PresentingToButtonBrushConverter}}"
                        Padding="18,9"/>
            </StackPanel>
        </Grid>

        <!-- Main Workspace Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Script Editor & Slide Strip -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Editor Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ROTEIRO"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <Border Padding="7,2"
                                    CornerRadius="6"
                                    Background="{StaticResource ElevatedSurfaceBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SlideCountLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#A5B4FC"/>
                            </Border>
                            <Border Margin="6,0,0,0"
                                    Padding="8,2"
                                    CornerRadius="6"
                                    Background="#252A42"
                                    BorderBrush="#464E8A"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding EditingSlideLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E7FF"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentFileName}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="150"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+ Novo Slide"
                                    Click="OnInsertNewSlideClick"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,6,0"
                                    Foreground="#C7D2FE"
                                    BorderBrush="#464E8A"
                                    ToolTip="Insere um separador --- na posição atual do cursor"/>
                            <Button Content="Importar"
                                    Command="{Binding ImportScriptCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,6,0"
                                    ToolTip="Abrir arquivo .md ou .txt"/>
                            <Button Content="Salvar"
                                    Command="{Binding SaveScriptCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,6,0"
                                    ToolTip="Salvar roteiro como .md ou .txt"/>
                            <Button Content="Exemplo"
                                    Command="{Binding LoadSampleScriptCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Carregar roteiro de demonstração pré-preenchido"/>
                        </StackPanel>
                    </Grid>

                    <!-- Syntax Hint -->
                    <Border Grid.Row="1"
                            Background="#12141B"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,10">
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Dica: separe os slides com "/>
                            <Run Text="---" FontFamily="Consolas" FontWeight="Bold" Foreground="#A5B4FC"/>
                            <Run Text=" (ou clique em + Novo Slide). Os rótulos na margem esquerda indicam o número de cada slide em tempo real."/>
                        </TextBlock>
                    </Border>

                    <!-- Multiline Script Editor with Live Slide Number Gutter -->
                    <Border x:Name="EditorContainerBorder"
                            Grid.Row="2"
                            Background="#12141B"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#151823"
                                    BorderBrush="#232838"
                                    BorderThickness="0,0,1,0"
                                    ClipToBounds="True">
                                <Canvas x:Name="SlideGutterCanvas"
                                        ClipToBounds="True"/>
                            </Border>

                            <TextBox x:Name="ScriptEditorTextBox"
                                     Grid.Column="1"
                                     Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BorderlessEditorTextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     ScrollViewer.ScrollChanged="OnEditorScrollChanged"
                                     SelectionChanged="OnEditorSelectionChanged"
                                     TextChanged="OnEditorTextChanged"
                                     SizeChanged="OnEditorSizeChanged"
                                     GotKeyboardFocus="OnEditorGotFocus"
                                     LostKeyboardFocus="OnEditorLostFocus"/>
                        </Grid>
                    </Border>

                    <!-- Parsed Slides Quick Navigation Strip -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="SLIDES DETECTADOS (CLIQUE PARA SALTAR)"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6"/>

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Padding="0,0,0,4">
                            <ItemsControl ItemsSource="{Binding ParsedSlides}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SlideItem}">
                                        <Button Style="{StaticResource SlideChipButtonStyle}"
                                                Command="{Binding DataContext.SelectSlideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding PreviewText}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Number, StringFormat=Slide {0}}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E5E7EB"/>
                                                <TextBlock Text="{Binding WordCount, StringFormat=' ({0} pal.)'}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10.5"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Column: Real-Time Settings Panel -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>

                    <!-- Display Mode & Scroll Settings Card -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="MODO DE EXIBIÇÃO &amp; ROLAGEM" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- Display Mode Segmented Toggle -->
                            <Border Background="#12141B"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="3"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0"
                                                 Content="Linha Única"
                                                 GroupName="DisplayModeGroup"
                                                 IsChecked="{Binding IsSingleLineMode, Mode=TwoWay}"
                                                 Style="{StaticResource SegmentedToggleRadioStyle}"
                                                 ToolTip="Linha única horizontal deslizando da direita para a esquerda"/>
                                    <RadioButton Grid.Column="1"
                                                 Content="Bloco (2 linhas)"
                                                 GroupName="DisplayModeGroup"
                                                 IsChecked="{Binding IsCompactBlockMode, Mode=TwoWay}"
                                                 Style="{StaticResource SegmentedToggleRadioStyle}"
                                                 ToolTip="Bloco compacto exibindo 2 linhas verticais com rolagem suave para cima"/>
                                </Grid>
                            </Border>

                            <!-- Scroll Speed -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Velocidade de rolagem" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding ScrollSpeedPxPerSec, StringFormat={}{0:0} px/s}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#A5B4FC"/>
                            </Grid>
                            <Slider Minimum="15"
                                    Maximum="300"
                                    TickFrequency="1"
                                    Value="{Binding ScrollSpeedPxPerSec, Mode=TwoWay}"
                                    Margin="0,0,0,12"/>

                            <!-- Initial Micro-Pause -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Micro-pausa inicial no slide" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding InitialPauseSeconds, StringFormat={}{0:0.0} s}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#A5B4FC"/>
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="2"
                                    TickFrequency="0.1"
                                    Value="{Binding InitialPauseSeconds, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- Geometry, Typography & Monitor Card -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="APARÊNCIA &amp; POSICIONAMENTO" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- Bar Width -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Largura da barra" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding BarWidth, StringFormat={}{0:0} px}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#A5B4FC"/>
                            </Grid>
                            <Slider Minimum="350"
                                    Maximum="1200"
                                    TickFrequency="10"
                                    Value="{Binding BarWidth, Mode=TwoWay}"
                                    Margin="0,0,0,12"/>

                            <!-- Font Size -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Tamanho da fonte" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding FontSize, StringFormat={}{0:0} px}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#A5B4FC"/>
                            </Grid>
                            <Slider Minimum="14"
                                    Maximum="48"
                                    TickFrequency="1"
                                    Value="{Binding FontSize, Mode=TwoWay}"
                                    Margin="0,0,0,12"/>

                            <!-- Background Opacity -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Opacidade do fundo" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding BackgroundOpacityPercent, StringFormat={}{0}%}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#A5B4FC"/>
                            </Grid>
                            <Slider Minimum="0.25"
                                    Maximum="1.0"
                                    TickFrequency="0.05"
                                    Value="{Binding BackgroundOpacity, Mode=TwoWay}"
                                    Margin="0,0,0,12"/>

                            <!-- Top Margin -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Margem superior (posição vertical)" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding TopMarginPx, StringFormat={}{0:0} px}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#A5B4FC"/>
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="400"
                                    TickFrequency="2"
                                    Value="{Binding TopMarginPx, Mode=TwoWay}"
                                    Margin="0,0,0,12"/>

                            <!-- Monitor Selection -->
                            <TextBlock Text="Monitor de exibição"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Monitors}"
                                          SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"/>
                                <Button Grid.Column="1"
                                        Content="↻"
                                        Command="{Binding RefreshMonitorsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6,0,0,0"
                                        Padding="10,6"
                                        ToolTip="Atualizar lista de monitores conectados"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Win32 Privacy & Hook Options Card -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="PRIVACIDADE &amp; COMPORTAMENTO" Style="{StaticResource SectionTitleStyle}"/>

                            <CheckBox Content="Ocultar da gravação de tela (WDA_EXCLUDEFROMCAPTURE)"
                                      IsChecked="{Binding HideFromCapture, Mode=TwoWay}"
                                      ToolTip="Torna o teleprompter invisível no OBS, Discord, Teams, Zoom e capturas do Windows"/>

                            <CheckBox Content="Modo Fantasma / Click-Through (ignorar mouse)"
                                      IsChecked="{Binding IsClickThrough, Mode=TwoWay}"
                                      ToolTip="Ativado automaticamente ao iniciar apresentação. Cliques passam direto para os slides."/>

                            <CheckBox Content="Usar barra de espaço para avançar slide"
                                      IsChecked="{Binding UseSpaceToAdvance, Mode=TwoWay}"
                                      ToolTip="Por padrão, Right / Left / PageDown / PageUp já funcionam globalmente."/>
                        </StackPanel>
                    </Border>

                    <!-- Global Shortcuts Cheat Sheet Card -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="ATALHOS GLOBAIS (DURANTE APRESENTAÇÃO)" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Próximo slide" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="→ / PageDown" FontFamily="Consolas" FontSize="11.5" Foreground="#E5E7EB"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Slide anterior" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="← / PageUp" FontFamily="Consolas" FontSize="11.5" Foreground="#E5E7EB"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Pausar / Retomar" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="Ctrl + Alt + Space" FontFamily="Consolas" FontSize="11.5" Foreground="#E5E7EB"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Velocidade (+15 / -15 px/s)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="Ctrl + Alt + ↑ / ↓" FontFamily="Consolas" FontSize="11.5" Foreground="#E5E7EB"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Reiniciar slide atual" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="Ctrl + Alt + R" FontFamily="Consolas" FontSize="11.5" Foreground="#E5E7EB"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Mostrar / Ocultar barra" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="Ctrl + Alt + H" FontFamily="Consolas" FontSize="11.5" Foreground="#E5E7EB"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Bar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       FontSize="11.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="Clique no ícone na bandeja do sistema para reabrir os controles rapidamente"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>

